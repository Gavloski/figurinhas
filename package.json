{
  "name": "whatsapp-sticker-maker",
  "version": "2.0.0",
  "private": true,
  "description": "Criador online e bot de figurinhas para WhatsApp",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "bot": "node src/index.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check src/index.js && node --check src/media.js && node --check public/app.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "file-type": "^19.6.0",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "wa-sticker-formatter": "^4.4.4"
  }
}
